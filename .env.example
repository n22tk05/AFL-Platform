# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Image -> Markdown: OpenCV -> Google Enterprise OCR -> deterministic assembler
# -> validation -> human review -> .md. No Gemini key needed for Markdown.
# Shared with FR-6 structured extraction. Never use NEXT_PUBLIC_ for these values.
DOCUMENT_OCR_PROVIDER=vietocr
VIETOCR_ENDPOINT=http://localhost:8000/predict
DOCUMENT_OCR_TIMEOUT_MS=60000
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_LOCATION=us
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=
# Optional: pin an Enterprise OCR processor version; blank uses processor default.
GOOGLE_DOCUMENT_AI_PROCESSOR_VERSION=
# Optional for local ADC: absolute path OUTSIDE this repository. On Cloud use workload identity.
GOOGLE_APPLICATION_CREDENTIALS=
# Optional for separate classification/business-field extraction from raw OCR text.
GEMINI_API_KEY=
GEMINI_DOCUMENT_MODEL=gemini-2.5-flash
DOCUMENT_ACCEPTANCE_THRESHOLD=0.95

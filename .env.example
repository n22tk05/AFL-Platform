# =============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG DỰ ÁN AFL (AFL PLATFORM)
# =============================================================================

# Công tắc Mock Data (true = chạy mock không cần API/DB, false = gọi API thật)
NEXT_PUBLIC_USE_MOCK_DATA=true

# Google Gemini 1.5 Flash (Dành cho Người 4 & Người 1)
GEMINI_API_KEY=

# Google Cloud Text-to-Speech (Neural2 vi-VN)
GOOGLE_TTS_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=./config/google-cloud-key.json

# Chế độ bộ nhớ đệm cục bộ chống cháy Quota API (Người 4 - Voice AI)
VOICE_CACHE_ENABLED=true

# PostgreSQL Database (Dành cho Người 1 - Tech Lead)
DATABASE_URL=postgresql://user:password@localhost:5432/afl_db?schema=public

# Máy chủ phát triển
PORT=3000

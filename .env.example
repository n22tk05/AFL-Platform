# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Image -> Markdown: OpenCV -> local VietOCR -> deterministic assembler
# -> validation -> human review -> .md. No Gemini key needed for Markdown.
# Shared with FR-6 structured extraction. Never use NEXT_PUBLIC_ for these values.
DOCUMENT_OCR_PROVIDER=vietocr
VIETOCR_ENDPOINT=http://127.0.0.1:8000/predict
DOCUMENT_OCR_TIMEOUT_MS=60000
# Optional Google Cloud Text-to-Speech only: credential path outside this repository.
GOOGLE_APPLICATION_CREDENTIALS=
# Optional for separate classification/business-field extraction from raw OCR text.
GEMINI_API_KEY=
GEMINI_DOCUMENT_MODEL=gemini-2.5-flash
DOCUMENT_ACCEPTANCE_THRESHOLD=0.95

# Domain công khai phục vụ mã QR quét camera Một cửa (ngrok / production domain)
NEXT_PUBLIC_APP_URL=https://crayfish-exodus-stingray.ngrok-free.dev

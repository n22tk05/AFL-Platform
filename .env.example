# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# FR-6: server-only OCR. Never use NEXT_PUBLIC_ for these values.
DOCUMENT_OCR_PROVIDER=google-document-ai
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_LOCATION=us
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=
# Optional for local ADC: absolute path OUTSIDE this repository. On Cloud use workload identity.
GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_API_KEY=
GEMINI_DOCUMENT_MODEL=gemini-2.5-flash
DOCUMENT_ACCEPTANCE_THRESHOLD=0.95
